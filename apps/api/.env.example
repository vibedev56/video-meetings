DATABASE_URL="postgresql://postgres:postgres@localhost:5432/video_meetings?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1h"
PORT=3000
MEETING_FILES_DIR="./storage/meeting-files"
AVATARS_DIR="./storage/avatars"
# Local openai-whisper CLI (needs `whisper` and `ffmpeg` on PATH)
WHISPER_BIN="whisper"
WHISPER_MODEL="tiny"
WHISPER_TIMEOUT_MS=1800000

# AI analysis of transcripts: a local model behind Ollama (https://ollama.com).
# Install Ollama, then run `ollama pull qwen3:4b-instruct-2507-q4_K_M` once.
OLLAMA_BASE_URL="http://localhost:11434"
AI_MODEL="qwen3:4b-instruct-2507-q4_K_M"
# Context window in tokens; raising it uses more memory and is slower.
AI_NUM_CTX=8192
# Time limit for one whole analysis run (default 30 minutes).
AI_RUN_TIMEOUT_MS=1800000
# Chunk size in characters for long transcripts.
AI_CHUNK_CHARS=12000
