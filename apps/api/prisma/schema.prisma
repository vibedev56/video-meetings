generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?   @db.VarChar(100)
  avatarFile   String?
  createdAt    DateTime  @default(now())
  meetings     Meeting[]

  @@map("users")
}

model Meeting {
  id           String        @id @default(uuid())
  title        String
  date         DateTime
  participants String[]
  createdAt    DateTime      @default(now())
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files        MeetingFile[]

  @@index([ownerId])
  @@map("meetings")
}

model MeetingFile {
  id            String         @id @default(uuid())
  meetingId     String
  meeting       Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  originalName  String
  storedName    String         @unique
  sizeBytes     Int
  mimeType      String
  uploadedAt    DateTime       @default(now())
  transcription Transcription? @relation("MeetingFileTranscription")

  @@index([meetingId])
  @@map("meeting_files")
}

enum TranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Transcription {
  id            String              @id @default(uuid())
  meetingFileId String              @unique
  meetingFile   MeetingFile         @relation("MeetingFileTranscription", fields: [meetingFileId], references: [id], onDelete: Cascade)
  status        TranscriptionStatus @default(PENDING)
  text          String?
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([meetingFileId])
  @@index([status])
  @@map("transcriptions")
}
