generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  avatarFile   String?
  createdAt    DateTime  @default(now())
  meetings     Meeting[]

  @@map("users")
}

model Meeting {
  id           String   @id @default(uuid())
  title        String
  date         DateTime
  participants String[]
  createdAt    DateTime @default(now())
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files        MeetingFile[]

  @@index([ownerId])
  @@map("meetings")
}

model MeetingFile {
  id           String   @id @default(uuid())
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  originalName String
  storedName   String   @unique
  sizeBytes    Int
  mimeType     String
  uploadedAt   DateTime @default(now())

  @@index([meetingId])
  @@map("meeting_files")
}
